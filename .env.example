# CampusFix environment template. Copy to .env for local development only.
# Never commit .env or place real production secrets in this file.

# LOCAL DEVELOPMENT DEFAULTS
DJANGO_PRODUCTION=False
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=replace-with-a-long-random-local-value
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
SITE_URL=http://127.0.0.1:8000
# Leave DATABASE_URL empty to use db.sqlite3 locally.
DATABASE_URL=
# Leave false to keep uploads in the local media/ directory.
USE_S3_MEDIA=False

# PRODUCTION (set these in Vercel Project Settings, not in a committed file)
# DJANGO_PRODUCTION=True
# DJANGO_DEBUG=False
# DJANGO_SECRET_KEY=<long-random-production-secret>
# DJANGO_ALLOWED_HOSTS=<project>.vercel.app,your-domain.example
# DJANGO_CSRF_TRUSTED_ORIGINS=https://<project>.vercel.app,https://your-domain.example
# SITE_URL=https://your-domain.example
# DATABASE_URL=postgresql://<user>:<password>@<neon-pooled-host>/<database>?sslmode=require
# Optional; Vercel provides this automatically for each deployment.
# VERCEL_URL=<deployment-host>.vercel.app

# OPTIONAL PERSISTENT S3-COMPATIBLE MEDIA STORAGE
# USE_S3_MEDIA=True
# AWS_ACCESS_KEY_ID=<storage-access-key>
# AWS_SECRET_ACCESS_KEY=<storage-secret-key>
# AWS_STORAGE_BUCKET_NAME=<bucket-name>
# AWS_S3_ENDPOINT_URL=https://<provider-endpoint>
# AWS_S3_REGION_NAME=<provider-region>
# AWS_S3_CUSTOM_DOMAIN=<optional-cdn-or-public-media-domain>
# Keep True for private objects and signed image URLs; use False only for a public bucket.
# AWS_QUERYSTRING_AUTH=True

# OPTIONAL PRODUCTION HSTS TUNING (secure defaults shown)
# DJANGO_HSTS_SECONDS=31536000
# DJANGO_HSTS_INCLUDE_SUBDOMAINS=True
# DJANGO_HSTS_PRELOAD=True
